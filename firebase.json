
{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      "**/.*",
      "functions/**",
      "**/node_modules/**",
      "client-secret",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "FIREBASE-SETUP.md",
      "firestore.rules"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/Login-page/login.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ]
}
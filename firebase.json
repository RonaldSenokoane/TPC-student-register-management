{
  "hosting": {
    "public": "public",
    "ignore": [
      "**/.*",
      "**/node_modules/**",
      "**/pages-needing-review.json",
      "**/*.zip",
      "**/*.pdf"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/auth/sign-in.html",
        "type": 302
      },
      {
        "source": "/Login-page/login.html",
        "destination": "/auth/sign-in.html",
        "type": 302
      },
      {
        "source": "/Login-page/accept-invitation.html",
        "destination": "/auth/accept-invitation.html",
        "type": 302
      },
      {
        "source": "/dashboard/dashboard.html",
        "destination": "/dashboard/index.html",
        "type": 302
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ]
}
